IDD_OPT_ONLINE DIALOGEX 0, 0, 300, 200
STYLE PAGE_STYLE
CAPTION "Online Meetings"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Default &provider:", -1, 7, 9, 70, 8
    COMBOBOX        IDC_DEFCONF, 80, 7, 130, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP

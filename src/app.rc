// WinCalendar resources
#include <windows.h>
#include <commctrl.h>
#include "resource.h"

LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US

IDI_APP ICON "res\\app.ico"

#include "ribbon.rc"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "WinCalendar - Ribbon calendar for Windows"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "ProductName", "WinCalendar"
            VALUE "ProductVersion", "1.0.0.0"
            VALUE "OriginalFilename", "WinCalendar.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "N", IDM_NEWEVENT, VIRTKEY, CONTROL
    "M", IDM_NEWMEETING, VIRTKEY, CONTROL, SHIFT
    "K", IDM_NEWTASK, VIRTKEY, CONTROL, SHIFT
    "F", IDM_SEARCH, VIRTKEY, CONTROL
    "E", IDM_FOCUSSEARCH, VIRTKEY, CONTROL
    "T", IDM_TODAY, VIRTKEY, CONTROL
    "G", IDM_GOTO, VIRTKEY, CONTROL
    "1", IDM_VIEWDAY, VIRTKEY, CONTROL
    "2", IDM_VIEWWEEK, VIRTKEY, CONTROL
    "3", IDM_VIEWMONTH, VIRTKEY, CONTROL
    "4", IDM_VIEWYEAR, VIRTKEY, CONTROL
    "5", IDM_VIEWAGENDA, VIRTKEY, CONTROL
    "I", IDM_IMPORT, VIRTKEY, CONTROL
    "O", IDM_OPEN, VIRTKEY, CONTROL
    VK_F5, IDM_SYNC, VIRTKEY
    VK_F1, IDM_ABOUT, VIRTKEY
END

#define PAGE_STYLE DS_SHELLFONT | DS_CONTROL | WS_CHILD | WS_CAPTION
#define DLG_STYLE  DS_SHELLFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU

// ===================================================================== Event dialog pages
IDD_EV_GENERAL DIALOGEX 0, 0, 330, 236
STYLE PAGE_STYLE
CAPTION "General"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Title:", -1, 7, 9, 50, 8
    EDITTEXT        IDC_TITLE, 60, 7, 263, 13, ES_AUTOHSCROLL
    LTEXT           "&Location:", -1, 7, 27, 50, 8
    EDITTEXT        IDC_LOCATION, 60, 25, 263, 13, ES_AUTOHSCROLL
    LTEXT           "&Calendar:", -1, 7, 45, 50, 8
    COMBOBOX        IDC_CALENDAR, 60, 43, 110, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "Cate&gory:", -1, 178, 45, 36, 8
    COMBOBOX        IDC_CATEGORY, 216, 43, 107, 120, CBS_DROPDOWN | CBS_AUTOHSCROLL | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Starts:", -1, 7, 65, 50, 8
    CONTROL         "", IDC_STARTDATE, DATETIMEPICK_CLASS, DTS_SHORTDATECENTURYFORMAT | WS_TABSTOP, 60, 63, 90, 13
    CONTROL         "", IDC_STARTTIME, DATETIMEPICK_CLASS, DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP, 154, 63, 70, 13
    AUTOCHECKBOX    "&All-day event", IDC_ALLDAY, 236, 64, 87, 10
    LTEXT           "&Ends:", -1, 7, 83, 50, 8
    CONTROL         "", IDC_ENDDATE, DATETIMEPICK_CLASS, DTS_SHORTDATECENTURYFORMAT | WS_TABSTOP, 60, 81, 90, 13
    CONTROL         "", IDC_ENDTIME, DATETIMEPICK_CLASS, DTS_TIMEFORMAT | DTS_UPDOWN | WS_TABSTOP, 154, 81, 70, 13
    LTEXT           "", IDC_TZNOTE, 236, 80, 87, 18, SS_NOPREFIX
    LTEXT           "Show &as:", -1, 7, 101, 50, 8
    COMBOBOX        IDC_BUSY, 60, 99, 110, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "", IDC_SUMMARY, 178, 101, 145, 8, SS_ENDELLIPSIS | SS_NOPREFIX
    LTEXT           "&Notes:", -1, 7, 119, 50, 8
    EDITTEXT        IDC_DESC, 60, 117, 263, 98, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
    LTEXT           "", IDC_READONLY, 7, 221, 316, 8, SS_NOPREFIX
END

IDD_EV_RECUR DIALOGEX 0, 0, 330, 236
STYLE PAGE_STYLE
CAPTION "Recurrence"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "&Repeat:", -1, 7, 9, 50, 8
    COMBOBOX        IDC_FREQ, 60, 7, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "E&very:", -1, 172, 9, 26, 8
    EDITTEXT        IDC_INTERVAL, 200, 7, 32, 13, ES_NUMBER
    CONTROL         "", IDC_INTERVAL_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 232, 7, 10, 13
    LTEXT           "", IDC_UNITS, 238, 9, 80, 8, SS_NOPREFIX
    GROUPBOX        "Weekly - repeat on", IDC_WEEKDAYS, 7, 28, 316, 44
    AUTOCHECKBOX    "Sun", IDC_WD0, 15, 42, 40, 10
    AUTOCHECKBOX    "Mon", IDC_WD0+1, 58, 42, 40, 10
    AUTOCHECKBOX    "Tue", IDC_WD0+2, 101, 42, 40, 10
    AUTOCHECKBOX    "Wed", IDC_WD0+3, 144, 42, 40, 10
    AUTOCHECKBOX    "Thu", IDC_WD0+4, 187, 42, 40, 10
    AUTOCHECKBOX    "Fri", IDC_WD0+5, 230, 42, 40, 10
    AUTOCHECKBOX    "Sat", IDC_WD0+6, 273, 42, 40, 10
    PUSHBUTTON      "Week&days", IDC_FIRSTMON, 15, 55, 50, 13
    GROUPBOX        "Monthly / yearly pattern", -1, 7, 78, 316, 48
    AUTORADIOBUTTON "On the same &day of the month", IDC_MONTH_DAY, 15, 92, 200, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "On &the", IDC_MONTH_NTH, 15, 108, 40, 10
    COMBOBOX        IDC_NTH, 60, 106, 60, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    COMBOBOX        IDC_NTHDAY, 126, 106, 80, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "(e.g. ""every first Monday"")", -1, 212, 108, 108, 8
    GROUPBOX        "End", -1, 7, 132, 316, 62
    AUTORADIOBUTTON "&Never", IDC_END_NEVER, 15, 146, 80, 10, WS_GROUP | WS_TABSTOP
    AUTORADIOBUTTON "&Until:", IDC_END_UNTIL, 15, 162, 50, 10
    CONTROL         "", IDC_UNTILDATE, DATETIMEPICK_CLASS, DTS_SHORTDATECENTURYFORMAT | WS_TABSTOP, 70, 160, 90, 13
    AUTORADIOBUTTON "A&fter:", IDC_END_COUNT, 15, 178, 50, 10
    EDITTEXT        IDC_COUNT, 70, 176, 36, 13, ES_NUMBER
    CONTROL         "", IDC_COUNT_SPIN, UPDOWN_CLASS, UDS_SETBUDDYINT | UDS_ALIGNRIGHT | UDS_AUTOBUDDY | UDS_ARROWKEYS, 106, 176, 10, 13
    LTEXT           "occurrences", -1, 112, 178, 60, 8
    LTEXT           "", IDC_SUMMARY, 7, 204, 316, 24, SS_NOPREFIX
END

IDD_EV_TZ DIALOGEX 0, 0, 330, 236
STYLE PAGE_STYLE
CAPTION "Time Zone"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Choose how this event behaves when you travel or change your time zone.", -1, 7, 7, 316, 16
    AUTORADIOBUTTON "&Lock to a specific time zone (the event shifts on your calendar when you are in another zone):", IDC_TZ_PINNED, 7, 28, 316, 10, WS_GROUP | WS_TABSTOP
    COMBOBOX        IDC_TZCOMBO, 19, 42, 304, 200, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Use &my location", IDC_TZMINE, 19, 59, 80, 14
    AUTOCHECKBOX    "&Keep the same moment when changing zone (convert the start time)", IDC_TZCONVERT, 105, 61, 218, 10
    AUTORADIOBUTTON "&Floating - same clock time in every time zone (e.g. ""take medicine at 8:00"")", IDC_TZ_FLOATING, 7, 82, 316, 10
    GROUPBOX        "Preview", -1, 7, 100, 316, 100
    LTEXT           "", IDC_TZPREVIEW, 15, 113, 300, 82, SS_NOPREFIX
    LTEXT           "The date and time on the General tab are entered in the event's own time zone.", -1, 7, 208, 316, 16
END

IDD_EV_ATTENDEES DIALOGEX 0, 0, 330, 236
STYLE PAGE_STYLE
CAPTION "Attendees"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "", IDC_ORGANIZER, 7, 7, 316, 8, SS_NOPREFIX
    CONTROL         "", IDC_ATTLIST, WC_LISTVIEW, LVS_REPORT | LVS_SHOWSELALWAYS | LVS_SINGLESEL | WS_BORDER | WS_TABSTOP, 7, 19, 316, 106
    LTEXT           "&Name:", -1, 7, 133, 30, 8
    EDITTEXT        IDC_ATTNAME, 38, 131, 100, 13, ES_AUTOHSCROLL
    LTEXT           "&E-mail:", -1, 144, 133, 28, 8
    EDITTEXT        IDC_ATTEMAIL, 172, 131, 151, 13, ES_AUTOHSCROLL
    AUTOCHECKBOX    "&Optional", IDC_ATTOPTIONAL, 38, 149, 60, 10
    PUSHBUTTON      "&Add", IDC_ATTADD, 213, 147, 52, 14
    PUSHBUTTON      "&Remove", IDC_ATTREMOVE, 271, 147, 52, 14
    LTEXT           "Response:", -1, 7, 170, 40, 8
    COMBOBOX        IDC_ATTSTATUS, 48, 168, 100, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Set res&ponse", IDC_ATTSETSTATUS, 154, 167, 60, 14
    AUTOCHECKBOX    "&Send invitations by e-mail when I click OK", IDC_SENDINVITES, 7, 190, 316, 10
    LTEXT           "My response:", -1, 7, 210, 50, 8
    COMBOBOX        IDC_MYRESPONSE, 60, 208, 120, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

IDD_EV_ONLINE DIALOGEX 0, 0, 330, 236
STYLE PAGE_STYLE
CAPTION "Online Meeting"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Attach a one-click video conference link. It is included in the invitation e-mail and the .ics file (CONFERENCE / Teams / Meet properties).", -1, 7, 7, 316, 24
    LTEXT           "&Provider:", -1, 7, 40, 50, 8
    COMBOBOX        IDC_CONFPROVIDER, 60, 38, 130, 120, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Generate link", IDC_CONFGENERATE, 196, 37, 70, 14
    LTEXT           "&Link:", -1, 7, 60, 50, 8
    EDITTEXT        IDC_CONFLINK, 60, 58, 263, 13, ES_AUTOHSCROLL
    PUSHBUTTON      "&Join now", IDC_CONFJOIN, 60, 77, 60, 14
    PUSHBUTTON      "&Copy link", IDC_CONFCOPY, 126, 77, 60, 14
    AUTOCHECKBOX    "Also put the link in the &Location field", IDC_CONFINLOC, 60, 98, 263, 10
    LTEXT           "", IDC_CONFHINT, 7, 118, 316, 80, SS_NOPREFIX
END

IDD_EV_REMIND DIALOGEX 0, 0, 330, 236
STYLE PAGE_STYLE
CAPTION "Reminders"
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
    LTEXT           "Re&minders for this event:", -1, 7, 7, 200, 8
    LISTBOX         IDC_REMLIST, 7, 18, 200, 80, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_BORDER | WS_TABSTOP
    LTEXT           "&When:", -1, 214, 18, 40, 8
    COMBOBOX        IDC_REMTIME, 214, 28, 109, 160, CBS_DROPDOWN | WS_VSCROLL | WS_TABSTOP
    LTEXT           "&Notify by:", -1, 214, 46, 40, 8
    COMBOBOX        IDC_REMMETHOD, 214, 56, 109, 100, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "&Add", IDC_REMADD, 214, 76, 52, 14
    PUSHBUTTON      "&Remove", IDC_REMREMOVE, 271, 76, 52, 14
    LTEXT           "Type minutes (e.g. 45) or pick a preset. Pop-up reminders appear in a reminder window and as a notification; e-mail reminders are sent to your own address.", -1, 7, 104, 316, 24
    GROUPBOX        "Focus time / out of office", -1, 7, 134, 316, 92
    AUTOCHECKBOX    "Automatically &decline new invitations that overlap this event", IDC_AUTODECLINE, 15, 148, 300, 10
    LTEXT           "Decline &message:", -1, 15, 164, 100, 8
    EDITTEXT        IDC_DECLINEMSG, 15, 175, 300, 44, ES_MULTILINE | ES_AUTOVSCROLL | ES_WANTRETURN | WS_VSCROLL
END

